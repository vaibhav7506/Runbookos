{
  "name": "@runbookos/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Generated TypeScript API client from the RunbookOS OpenAPI spec",
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "devDependencies": {
    "openapi-typescript": "^7.10.1"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "minimatch": "10.2.5"
  }
}
