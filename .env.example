# ======================================================================
# RunbookOS Environment Configuration
# ======================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file.
# ======================================================================

# ----------------------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=runbookos
POSTGRES_USER=runbookos
POSTGRES_PASSWORD=change_me_in_production

# ----------------------------------------------------------------------
# Redis
# ----------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ----------------------------------------------------------------------
# Spring Boot Control Plane
# ----------------------------------------------------------------------
CONTROL_PLANE_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# JWT secret - generate a strong random value for production
JWT_SECRET=replace-with-a-strong-random-secret-min-64-chars-long-for-production-use

# ----------------------------------------------------------------------
# n8n Workflow Engine
# ----------------------------------------------------------------------
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_in_production
N8N_ENCRYPTION_KEY=replace-with-a-strong-random-encryption-key

# n8n Database (uses same PostgreSQL instance, different database)
N8N_DB_TYPE=postgresdb
N8N_DB_POSTGRESDB_HOST=postgres
N8N_DB_POSTGRESDB_PORT=5432
N8N_DB_POSTGRESDB_DATABASE=n8n
N8N_DB_POSTGRESDB_USER=runbookos
N8N_DB_POSTGRESDB_PASSWORD=change_me_in_production

# ----------------------------------------------------------------------
# Next.js Web Application
# ----------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
WEB_PORT=3000

# ----------------------------------------------------------------------
# AI Providers (optional - Demo Mode works without these)
# ----------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_AI_API_KEY=...

# ----------------------------------------------------------------------
# Integrations (optional - Demo Mode works without these)
# ----------------------------------------------------------------------
# GITHUB_APP_ID=
# GITHUB_PRIVATE_KEY_PATH=
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=
# SENTRY_DSN=

# ----------------------------------------------------------------------
# Internal Communication
# ----------------------------------------------------------------------
# HMAC secret for Spring Boot <-> n8n signed communication
INTERNAL_HMAC_SECRET=replace-with-a-strong-random-hmac-secret
